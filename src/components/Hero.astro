---
import OceanBg from './OceanBg.astro';
---

<section class="hero" id="inicio" aria-labelledby="hero-titulo">
  <OceanBg priority class="hero__bg" />
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="hero__content wrap">
    <h1 class="display" id="hero-titulo">Marcas<br /> que crescem<br /> em ondas</h1>
    <p class="hero__text">
      Estratégia, compromisso e entrega.<br />
      Sempre com o mesmo objetivo, <strong>crescimento</strong>.
    </p>
  </div>
</section>
