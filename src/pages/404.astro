---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
---

<Base title="Página não encontrada · Wave Studio" noindex>
  <main id="conteudo" class="not-found">
    <div class="wrap">
      <Logo />
      <h1 class="display">Esta onda<br /> não chegou</h1>
      <p>A página que procura não existe ou mudou de lugar.</p>
      <a class="btn btn--light" href="/">Voltar ao início</a>
    </div>
  </main>
</Base>
